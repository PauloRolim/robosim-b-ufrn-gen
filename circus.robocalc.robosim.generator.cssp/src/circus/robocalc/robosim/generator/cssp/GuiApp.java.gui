package circus.robocalc.robosim.generator.cssp;

import java.io.File;

import javafx.application.Application;
import javafx.application.Platform;
import javafx.geometry.Insets;
import javafx.geometry.Pos;
import javafx.scene.Scene;
import javafx.scene.control.Button;
import javafx.scene.control.Label;
import javafx.scene.control.TextArea;
import javafx.scene.layout.HBox;
import javafx.scene.layout.Priority;
import javafx.scene.layout.VBox;
import javafx.scene.text.Font;
import javafx.stage.FileChooser;
import javafx.stage.Stage;

public class GuiApp extends Application {

    private File arquivoSelecionado;
    private Label labelArquivo;
    private TextArea areaSaida;
    private Button btnTraduzir;

    @Override
    public void start(Stage stage) {
        // Topo: seleção de arquivo
        Button btnSelecionar = new Button("📂 Selecionar arquivo .rst");
        btnSelecionar.setOnAction(e -> selecionarArquivo(stage));
        btnSelecionar.setFont(Font.font(16));

        labelArquivo = new Label("Nenhum arquivo selecionado");
        labelArquivo.setStyle("-fx-text-fill: gray;");
        labelArquivo.setFont(Font.font(16));

        HBox topo = new HBox(16, btnSelecionar, labelArquivo);
        topo.setAlignment(Pos.CENTER_LEFT);

        // Meio: botão traduzir
        btnTraduzir = new Button("▶ Traduzir");
        btnTraduzir.setDisable(true);
        btnTraduzir.setStyle("-fx-font-weight: bold;");
        btnTraduzir.setOnAction(e -> executarTraducao());
        btnTraduzir.setFont(Font.font(16));

        // Saída: área de texto
        areaSaida = new TextArea();
        areaSaida.setEditable(false);
        areaSaida.setFont(Font.font("Consolas", 16));
        areaSaida.setPromptText("As mensagens de progresso aparecerão aqui...");
        VBox.setVgrow(areaSaida, Priority.ALWAYS);

        VBox root = new VBox(16, topo, btnTraduzir, areaSaida);
        root.setPadding(new Insets(16));

        stage.setTitle("Tradutor RoboSim → CSSP");
        stage.setScene(new Scene(root, 800, 600));
        stage.show();
    }

    private void selecionarArquivo(Stage stage) {
        FileChooser fc = new FileChooser();
        fc.setTitle("Selecionar arquivo RoboSim");
        fc.getExtensionFilters().add(
            new FileChooser.ExtensionFilter("Arquivos RoboSim (*.rst)", "*.rst")
        );
        File f = fc.showOpenDialog(stage);
        if (f != null) {
            arquivoSelecionado = f;
            labelArquivo.setText(f.getName());
            labelArquivo.setStyle("-fx-text-fill: black;");
            btnTraduzir.setDisable(false);
        }
    }

    private void executarTraducao() {
        btnTraduzir.setDisable(true);
        areaSaida.clear();
        areaSaida.appendText("Iniciando tradução de: " + arquivoSelecionado.getName() + "\n\n");

        // Pasta de saída ao lado do arquivo de entrada
        File pastaSaida = new File(
            arquivoSelecionado.getParentFile(),
            "cssp-gen/sim"
        );

        // Roda em thread separada para não travar a UI
        new Thread(() -> {
            TraductorService service = new TraductorService();
            service.traduzir(
                arquivoSelecionado,
                pastaSaida,
                msg -> Platform.runLater(() -> areaSaida.appendText(msg + "\n"))
            );
            Platform.runLater(() -> btnTraduzir.setDisable(false));
        }).start();
    }

    public static void main(String[] args) {
        launch(args);
    }
}