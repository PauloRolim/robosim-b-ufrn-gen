IMPLEMENTATION
	logic_i
 		
REFINES
 	logic
SEES
 	g_types,
 	g_operators,
 	io_constants,
 	lchip_interface,
 	user_ctx,
 	inputs

CONCRETE_VARIABLES
board_0_O1,
board_0_O2,
first_time,
SM_Movement_state,
SM_Delivery_state,
cycle_timer,
cycle_state,
Movement_MovingCycles,
o_move_lv, 
o_drop,
i_obstacle,
Movement_arrived,
Delivery_arrived

INVARIANT 
board_0_O1 : uint8_t &
board_0_O2 : uint8_t &
first_time: BOOL &
SM_Movement_state : uint32_t &
SM_Movement_state : {INIT, FINAL, EXEC_1, EXEC_2, EXEC_3} &
SM_Delivery_state : uint32_t &
SM_Delivery_state : {INIT, FINAL, EXEC_1} &
cycle_timer: uint32_t &
cycle_state: uint8_t &
cycle_state: {st_READ_INPUTS, st_STATE_MACHINE, st_WRITE_OUTPUTS, st_TIME} &
Movement_MovingCycles : uint32_t &
o_move_lv : uint8_t &
o_drop : uint8_t &
i_obstacle : uint8_t &
Movement_arrived : uint8_t &
Delivery_arrived : uint8_t

INITIALISATION
    
board_0_O1 := IO_OFF;
board_0_O2 := IO_OFF;
first_time:= TRUE;
cycle_timer := 0;
cycle_state := st_READ_INPUTS;
SM_Movement_state := INIT;
SM_Delivery_state := INIT;
Movement_MovingCycles := 0;
o_move_lv := IO_OFF; 
o_drop := IO_OFF;
i_obstacle := IO_OFF;
Movement_arrived := IO_OFF;
Delivery_arrived := IO_OFF

LOCAL_OPERATIONS

execute_model_cycle =
PRE cycle_state = st_TIME
THEN
first_time :: BOOL ||
cycle_timer :: uint32_t ||
cycle_state :: uint32_t ||
SM_Movement_state :: uint32_t ||
SM_Delivery_state :: uint32_t ||
i_obstacle :: uint8_t ||
o_move_lv :: uint8_t ||
o_drop :: uint8_t ||
Movement_arrived :: uint8_t ||
Delivery_arrived :: uint8_t
END;

SM_Movement =
PRE cycle_state = st_STATE_MACHINE
THEN
cycle_state :: uint32_t ||
SM_Movement_state :: uint32_t ||
Movement_MovingCycles :: uint32_t ||
Movement_arrived :: uint8_t ||
o_move_lv :: uint8_t
END;

SM_Delivery =
PRE cycle_state = st_STATE_MACHINE
THEN
cycle_state :: uint32_t ||
SM_Delivery_state :: uint32_t ||
Delivery_arrived :: uint8_t ||
o_drop :: uint8_t
END;

read_model_inputs =
PRE cycle_state = st_READ_INPUTS
THEN
cycle_state :: uint32_t ||
i_obstacle :: uint8_t
END;

read_i_obstacle =
PRE cycle_state = st_READ_INPUTS
THEN
    i_obstacle :: uint8_t
END;

write_model_outputs =
PRE cycle_state = st_WRITE_OUTPUTS
THEN
board_0_O1      :: uint8_t ||
board_0_O2      :: uint8_t ||
cycle_state     :: uint8_t
END;

write_o_move =
PRE cycle_state = st_WRITE_OUTPUTS
THEN  
board_0_O1  :: uint8_t ||
board_0_O2  :: uint8_t ||
cycle_state :: uint8_t
END;

write_o_move_lv =
PRE cycle_state = st_WRITE_OUTPUTS
THEN
   board_0_O1 :: uint8_t
END;
write_o_drop =
PRE cycle_state = st_WRITE_OUTPUTS
THEN
   board_0_O2 :: uint8_t
END;

move(l_lv) =
PRE l_lv:BOOL
THEN
    o_move_lv :: uint8_t
END;

controller_CPD =
PRE cycle_state = st_STATE_MACHINE
THEN
    Movement_arrived :: uint8_t ||
    Delivery_arrived :: uint8_t
END;

elapsed <-- since(timer) =
PRE timer:uint32_t & elapsed:uint32_t
THEN
	elapsed::uint32_t
END;

result <-- land(pp,qq) =
PRE pp:BOOL & qq:BOOL & result:BOOL
THEN
    result::BOOL
END;

result <-- lor(pp,qq) = 
PRE pp:BOOL & qq:BOOL & result:BOOL
THEN
 	result::BOOL
END;

result <-- lnot(pp) = 
PRE pp:BOOL & result:BOOL
THEN
 	result::BOOL
END;

tock =
BEGIN
 	skip
END

OPERATIONS

user_logic = 
BEGIN
    IF first_time = TRUE THEN 
       cycle_timer <-- get_ms_tick; 
       execute_model_cycle;
       cycle_state:= st_READ_INPUTS;
       first_time := FALSE

    ELSE
 	    VAR time_elapsed, cycle_duration IN 

            time_elapsed:(time_elapsed:uint32_t);
 	        cycle_duration:(cycle_duration:uint32_t);
 		    time_elapsed <-- since(cycle_timer);
 		    cycle_duration := mul_uint32(PoliteDelivery_cycleDef,cycle_unit);
 		    
 		    IF (cycle_duration <= time_elapsed) THEN
 		        cycle_timer <-- get_ms_tick;
 		        execute_model_cycle;
 		        cycle_state:= st_READ_INPUTS;
 		        tock
 		    END
 		END
 	END
END;

SM_Movement =
BEGIN
IF SM_Movement_state = INIT THEN
 move(Movement_lv);
 SM_Movement_state:= EXEC_1

ELSIF SM_Movement_state = EXEC_1 THEN
SM_Movement_state:= EXEC_3
ELSIF SM_Movement_state = EXEC_2 THEN
VAR guard_1, guard_2
IN
guard_1:(guard_1:BOOL);
guard_2:(guard_2:BOOL);
guard_1 := bool(i_obstacle = IO_ON);
guard_2 := bool(i_obstacle = IO_OFF);
IF (guard_1 = TRUE) THEN
SM_Movement_state:= EXEC_2
ELSIF (guard_2 = TRUE) THEN
move(Movement_lv);
SM_Movement_state:= EXEC_3
END
END
ELSIF SM_Movement_state = EXEC_3 THEN
VAR guard_1, guard_2, guard_3, guard_4, guard_5, guard_6, guard_7, guard_8,
guard_result_1, guard_result_2
IN
guard_1:(guard_1:BOOL);
guard_2:(guard_2:BOOL);
guard_3:(guard_3:BOOL);
guard_4:(guard_4:BOOL);
guard_5:(guard_5:BOOL);
guard_6:(guard_6:BOOL);
guard_7:(guard_7:BOOL);
guard_8:(guard_8:BOOL);
guard_result_1:(guard_result_1:BOOL);
guard_result_2:(guard_result_2:BOOL);
guard_1 := bool(Movement_MOVINGTARGET <= Movement_MovingCycles);
guard_2 := bool(Movement_MOVINGTARGET <= Movement_MovingCycles);
guard_3 <-- lnot(guard_2);
guard_4 := bool(i_obstacle = IO_ON);
guard_5 := bool(Movement_MOVINGTARGET <= Movement_MovingCycles);
guard_6 <-- lnot(guard_5);
guard_7 := bool(i_obstacle = IO_ON);
guard_8 <-- lnot(guard_7);
guard_result_1 <-- land(guard_3, guard_4);
guard_result_2 <-- land(guard_6, guard_8);
IF (guard_1 = TRUE) THEN
Movement_arrived := IO_ON;
move(FALSE);
SM_Movement_state:= FINAL
ELSIF (guard_result_1 = TRUE) THEN
move(FALSE);
SM_Movement_state:= EXEC_2
ELSIF (guard_result_2 = TRUE) THEN
Movement_MovingCycles := add_uint32(Movement_MovingCycles, 1);
SM_Movement_state:= EXEC_3
END
END
END;
cycle_state := st_WRITE_OUTPUTS
END;

SM_Delivery =
BEGIN
IF SM_Delivery_state = INIT THEN
 SM_Delivery_state:= EXEC_1
ELSIF SM_Delivery_state = EXEC_1 THEN
VAR guard_1, guard_2
IN
guard_1:(guard_1:BOOL);
guard_2:(guard_2:BOOL);
guard_1 := bool(Delivery_arrived = IO_OFF);
guard_2 := bool(Delivery_arrived = IO_ON);
IF (guard_1 = TRUE) THEN
SM_Delivery_state:= EXEC_1
ELSIF (guard_2 = TRUE) THEN
o_drop := IO_ON;
SM_Delivery_state:= FINAL
END
END
END;
cycle_state := st_WRITE_OUTPUTS
END;

execute_model_cycle =
BEGIN
read_model_inputs;
SM_Movement;
SM_Delivery;
controller_CPD;
write_model_outputs
END;

read_model_inputs =
BEGIN	    
    cycle_state := st_STATE_MACHINE; 
    read_i_obstacle 
END;

read_i_obstacle =
BEGIN
    i_obstacle <-- get_board_0_I1
END;

write_model_outputs =
BEGIN
cycle_state := st_TIME;
write_o_move;
write_o_drop
END;

write_o_move =
BEGIN
write_o_move_lv
END;

write_o_move_lv =
BEGIN
    board_0_O1 := o_move_lv
END;

write_o_drop =
BEGIN
    board_0_O2 := o_drop
END;


move(l_lv) =
BEGIN
    IF l_lv = TRUE
    THEN
        o_move_lv := IO_ON
    ELSE
        o_move_lv := IO_OFF
    END
END;

controller_CPD =
BEGIN
    Delivery_arrived := Movement_arrived
END;

elapsed <-- since(timer) =
BEGIN
     elapsed:(elapsed:uint32_t);
     VAR local_time IN 
         local_time:(local_time:uint32_t);
         local_time <-- get_ms_tick;
        elapsed := sub_uint32(local_time, timer)
     END
END;

result <-- land(pp,qq) =
BEGIN
    result := FALSE;
    IF (pp = TRUE) THEN
        IF (qq = TRUE) THEN
            result := TRUE
        END
    END
END;

result <-- lor(pp,qq) =
BEGIN
    result := TRUE;
    IF (pp = FALSE) THEN 
        IF (qq = FALSE) THEN
            result := FALSE
        END
    END
END;

result <-- lnot(pp) =
BEGIN
result := FALSE;
    IF (pp = FALSE) THEN
        result := TRUE
    END
END;

tock =
BEGIN
    skip
END;

po <-- get_board_0_O1 =
BEGIN
   po := board_0_O1
END;

po <-- get_board_0_O2 =
BEGIN
	po := board_0_O2
END

END
