IMPLEMENTATION
	logic_i
 		
REFINES
 	logic
SEES
 	g_types,
 	g_operators,
 	io_constants,
 	lchip_interface,
 	user_ctx,
 	inputs

CONCRETE_VARIABLES
board_0_O1,
board_0_O2,
first_time,
SM_SimSMovement_state,
cycle_timer,
cycle_state,
var_MBC_1,
o_move_lv, 
o_move_av,
i_obstacle

INVARIANT 
board_0_O1 : uint8_t &
board_0_O2 : uint8_t &
first_time: BOOL &
SM_SimSMovement_state : uint32_t &
SM_SimSMovement_state : {INIT, FINAL, EXEC_1, EXEC_2, EXEC_3} &
cycle_timer: uint32_t &
cycle_state: uint8_t &
cycle_state: {st_READ_INPUTS, st_STATE_MACHINE, st_WRITE_OUTPUTS, st_TIME} &
var_MBC_1 : uint32_t &
o_move_lv : uint8_t &
o_move_av : uint8_t &
i_obstacle : uint8_t

INITIALISATION
    
board_0_O1 := IO_OFF;
board_0_O2 := IO_OFF;
first_time:= TRUE;
cycle_timer := 0;
cycle_state := st_READ_INPUTS;
SM_SimSMovement_state := INIT;
var_MBC_1 := 0;
o_move_lv := IO_OFF; 
o_move_av := IO_OFF;
i_obstacle := IO_OFF

LOCAL_OPERATIONS

execute_model_cycle =
PRE cycle_state = st_TIME
THEN
first_time :: BOOL ||
cycle_timer :: uint32_t ||
cycle_state :: uint32_t ||
SM_SimSMovement_state :: uint32_t ||
var_MBC_1 :: uint32_t ||
i_obstacle :: uint8_t ||
o_move_lv :: uint8_t ||
o_move_av :: uint8_t
END;

SM_SimSMovement =
PRE cycle_state = st_STATE_MACHINE
THEN
cycle_state :: uint32_t ||
SM_SimSMovement_state :: uint32_t ||
var_MBC_1 :: uint32_t ||
o_move_lv :: uint8_t ||o_move_av :: uint8_t
END;

read_model_inputs =
PRE cycle_state = st_READ_INPUTS
THEN
    cycle_state :: uint32_t ||
    i_obstacle :: uint8_t
END;

read_i_obstacle =
PRE cycle_state = st_READ_INPUTS
THEN
    i_obstacle :: uint8_t
END;

write_model_outputs =
PRE cycle_state = st_WRITE_OUTPUTS
THEN
board_0_O1      :: uint8_t ||
board_0_O2      :: uint8_t ||
cycle_state     :: uint8_t
END;

write_o_move =
PRE cycle_state = st_WRITE_OUTPUTS
THEN  
board_0_O1  :: uint8_t ||
board_0_O2  :: uint8_t ||
cycle_state :: uint8_t
END;

write_o_move_lv =
PRE cycle_state = st_WRITE_OUTPUTS
THEN
    board_0_O1 :: uint8_t
END;

write_o_move_av =
PRE cycle_state = st_WRITE_OUTPUTS
THEN
    board_0_O2 :: uint8_t
END;


move(l_lv,l_av) =
PRE l_lv:BOOL & l_av:BOOL
THEN
    o_move_lv :: uint8_t ||
    o_move_av :: uint8_t
END;


elapsed <-- since(timer) =
PRE timer:uint32_t & elapsed:uint32_t
THEN
	elapsed::uint32_t
END;

result <-- land(pp,qq) =
PRE pp:BOOL & qq:BOOL & result:BOOL
THEN
    result::BOOL
END;

result <-- lor(pp,qq) = 
PRE pp:BOOL & qq:BOOL & result:BOOL
THEN
 	result::BOOL
END;

result <-- lnot(pp) = 
PRE pp:BOOL & result:BOOL
THEN
 	result::BOOL
END;

tock =
BEGIN
 	skip
END

OPERATIONS

user_logic = 
BEGIN
    IF first_time = TRUE THEN 
       cycle_timer <-- get_ms_tick; 
       execute_model_cycle;
       cycle_state:= st_READ_INPUTS;
       first_time := FALSE

    ELSE
 	    VAR time_elapsed, cycle_duration IN 

            time_elapsed:(time_elapsed:uint32_t);
 	        cycle_duration:(cycle_duration:uint32_t);
 		    time_elapsed <-- since(cycle_timer);
 		    cycle_duration := mul_uint32(SimCMovement_cycleDef,cycle_unit);
 		    
 		    IF (cycle_duration <= time_elapsed) THEN
 		        cycle_timer <-- get_ms_tick;
 		        execute_model_cycle;
 		        cycle_state:= st_READ_INPUTS;
 		        tock
 		    END
 		END
 	END
END;

SM_SimSMovement =
BEGIN
IF SM_SimSMovement_state = INIT THEN
 move(SimSMovement_lv, FALSE);
 SM_SimSMovement_state:= EXEC_1
ELSIF SM_SimSMovement_state = EXEC_1 THEN
VAR guard_1, guard_2
IN
guard_1:(guard_1:BOOL);
guard_2:(guard_2:BOOL);
guard_1 := bool(i_obstacle = IO_OFF);
guard_2 := bool(i_obstacle = IO_ON);
IF (guard_1 = TRUE) THEN
SM_SimSMovement_state:= EXEC_1
ELSIF (guard_2 = TRUE) THEN
var_MBC_1 <-- get_ms_tick;
move(FALSE, FALSE);
SM_SimSMovement_state:= EXEC_2
END
END

ELSIF SM_SimSMovement_state = EXEC_2 THEN
move(FALSE, SimSMovement_av);
SM_SimSMovement_state:= EXEC_3
ELSIF SM_SimSMovement_state = EXEC_3 THEN
VAR guard_1, guard_2,
since_local
IN
guard_1:(guard_1:BOOL);
guard_2:(guard_2:BOOL);
since_local:(since_local:uint32_t);
since_local <-- since(var_MBC_1);
guard_1 := bool(since_local < SimSMovement_Pi);
guard_2 := bool(SimSMovement_Pi <= since_local);
IF (guard_1 = TRUE) THEN
SM_SimSMovement_state:= EXEC_3
ELSIF (guard_2 = TRUE) THEN
move(SimSMovement_lv, FALSE);
SM_SimSMovement_state:= EXEC_1
END
END
END;
cycle_state := st_WRITE_OUTPUTS
END;

execute_model_cycle =
BEGIN
read_model_inputs;
SM_SimSMovement;
write_model_outputs
END;

read_model_inputs =
BEGIN	    
    cycle_state := st_STATE_MACHINE; 
    read_i_obstacle 
END;

read_i_obstacle =
BEGIN
    i_obstacle <-- get_board_0_I1
END;

write_model_outputs =
BEGIN
cycle_state := st_TIME;
write_o_move
END;

write_o_move =
BEGIN
write_o_move_lv;
write_o_move_av
END;

write_o_move_lv =
BEGIN
    board_0_O1 := o_move_lv
END;

write_o_move_av =
BEGIN
    board_0_O2 := o_move_av
END;


move(l_lv,l_av) =
BEGIN
    IF l_lv = TRUE
    THEN
        o_move_lv := IO_ON
    ELSE
        o_move_lv := IO_OFF
    END;
    IF l_av = TRUE
    THEN
        o_move_av := IO_ON
    ELSE
        o_move_av := IO_OFF
    END
END;


elapsed <-- since(timer) =
BEGIN
     elapsed:(elapsed:uint32_t);
     VAR local_time IN 
         local_time:(local_time:uint32_t);
         local_time <-- get_ms_tick;
        elapsed := sub_uint32(local_time, timer)
     END
END;

result <-- land(pp,qq) =
BEGIN
    result := FALSE;
    IF (pp = TRUE) THEN
        IF (qq = TRUE) THEN
            result := TRUE
        END
    END
END;

result <-- lor(pp,qq) =
BEGIN
    result := TRUE;
    IF (pp = FALSE) THEN 
        IF (qq = FALSE) THEN
            result := FALSE
        END
    END
END;

result <-- lnot(pp) =
BEGIN
result := FALSE;
    IF (pp = FALSE) THEN
        result := TRUE
    END
END;

tock =
BEGIN
    skip
END;

po <-- get_board_0_O1 =
BEGIN
   po := board_0_O1
END;

po <-- get_board_0_O2 =
BEGIN
	po := board_0_O2
END

END
